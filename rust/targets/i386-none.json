{
  "llvm-target": "i386-unknown-none",
  "data-layout": "e-m:e-p:32:32-i64:64-f80:32-n8:16:32-a:0:32-S32",
  "arch": "x86",
  "target-endian": "little",
  "target-pointer-width": 32,
  "target-c-int-width": 32,
  "os": "none",
  "env": "",
  "vendor": "unknown",
  "linker-flavor": "ld",
  "linker": "ld",
  "executables": true,
  "relocation-model": "static",
  "code-model": "small",
  "disable-redzone": true,
  "features": "+mmx,+sse,+sse2",
  "pre-link-args": {
    "ld": ["-m", "elf_i386"]
  }
}
